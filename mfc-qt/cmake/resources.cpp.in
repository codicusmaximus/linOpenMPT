// Generated by mfcqt_add_resources: @MFCQT_RES_FILE@ embedded in the
// binary, and @MFCQT_RES_FUNCTION@(), which makes it the executable's
// resources.
#include <afxwin.h>

asm(".section .rodata\n"
	".balign 16\n"
	".globl @MFCQT_RES_SYMBOL@_begin\n"
	".hidden @MFCQT_RES_SYMBOL@_begin\n"
	"@MFCQT_RES_SYMBOL@_begin:\n"
	".incbin \"@MFCQT_RES_FILE@\"\n"
	".globl @MFCQT_RES_SYMBOL@_end\n"
	".hidden @MFCQT_RES_SYMBOL@_end\n"
	"@MFCQT_RES_SYMBOL@_end:\n"
	".previous\n");

extern "C" const unsigned char @MFCQT_RES_SYMBOL@_begin[];
extern "C" const unsigned char @MFCQT_RES_SYMBOL@_end[];

void @MFCQT_RES_FUNCTION@()
{
	MfcQtRegisterResources(::GetModuleHandle(nullptr), @MFCQT_RES_SYMBOL@_begin,
		static_cast<size_t>(@MFCQT_RES_SYMBOL@_end - @MFCQT_RES_SYMBOL@_begin));
}
