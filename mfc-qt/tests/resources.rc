// mfc-qt's test resources, in the form Visual Studio writes them.
#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "mfc-qt test"
    IDS_HELLO               "Hello, world"
    IDS_ESCAPES             "Tab\tand\nnew line"
END

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN_TEST
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_FILE_EXIT_TEST
    END
END

IDR_MAINFRAME ACCELERATORS
BEGIN
    "O",            ID_FILE_OPEN_TEST,      VIRTKEY, CONTROL, NOINVERT
END

IDD_SETTINGS DIALOGEX 0, 0, 180, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Name:",IDC_NAME_LABEL,7,9,40,8
    EDITTEXT        IDC_NAME,50,7,120,14,ES_AUTOHSCROLL
    CONTROL         "&Loop",IDC_LOOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,28,60,10
    COMBOBOX        IDC_MODE,50,26,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,69,59,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,123,59,50,14
END

IDD_SETTINGS DLGINIT
BEGIN
    IDC_MODE, 0x403, 5, 0
0x6146, 0x7473, "\000"
    IDC_MODE, 0x403, 5, 0
0x6c53, 0x776f, "\000"
    0
END

IDB_DATA RCDATA "data.bin"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,3,4
 PRODUCTVERSION 1,2,3,4
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "mfc-qt test"
            VALUE "FileVersion", "1.2.3.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
